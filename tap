#!/bin/sh
# Create tap0 and the forwarding a guest uses to reach the network.
#
# tap0 is 172.16.0.1/30. The guest is 172.16.0.2, set when the microVM boots.
# A second run finds the device and the rules and leaves them.
# A reboot clears these settings.
#
# usage: sudo ./tap
set -eu

if [ "$(id -u)" -ne 0 ]; then
	echo "tap: run this with sudo" >&2
	exit 1
fi

name=tap0
want=172.16.0.1/30
if ! ip link show dev "$name" >/dev/null 2>&1; then
	ip tuntap add "$name" mode tap
fi
have=$(ip -4 -o addr show dev "$name" | awk '{print $4}')
if [ -n "$have" ] && [ "$have" != "$want" ]; then
	echo "tap: $name has $have, expected $want" >&2
	exit 1
fi
if [ -z "$have" ]; then
	ip addr add "$want" dev "$name"
fi
ip link set "$name" up

sysctl -w net.ipv4.ip_forward=1 >/dev/null
if ! iptables -t nat -C POSTROUTING -s 172.16.0.0/24 -j MASQUERADE 2>/dev/null; then
	iptables -t nat -A POSTROUTING -s 172.16.0.0/24 -j MASQUERADE
fi
if ! iptables -C FORWARD -i tap+ -j ACCEPT 2>/dev/null; then
	iptables -I FORWARD 1 -i tap+ -j ACCEPT
fi
if ! iptables -C FORWARD -o tap+ -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; then
	iptables -I FORWARD 1 -o tap+ -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
fi

echo "$name $want"
